# ===========================================
# Server-Side Only Variables (NOT exposed to browser)
# ===========================================
# These are used by API routes and server components only
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=your_database_id
# Server-only collection containing one immutable ballot per poll and voter.
APPWRITE_COLLECTION_ID_ASSEMBLY_VOTE_CASTS=assembly_vote_casts

# Google reCAPTCHA Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Active Captcha Provider Config ('google' | 'trustcaptcha' | 'disabled')
CAPTCHA_PROVIDER=google

# TrustCaptcha Secret Key (Preserved for fallback)
TRUST_CAPTCHA_API_KEY=your_trust_captcha_secret_key_here

# ===========================================
# Client-Side Variables (exposed to browser)
# ===========================================
# Only include these if you still need client-side Appwrite operations
# Consider removing these if all operations go through API routes
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id

# Active Captcha Provider Config (Exposed to client)
NEXT_PUBLIC_CAPTCHA_PROVIDER=google

# Google reCAPTCHA Site Key (Exposed to client)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# TrustCaptcha Site Key (Exposed to client)
NEXT_PUBLIC_TRUST_CAPTCHA_SITE_KEY=your_trust_captcha_site_key_here

# ===========================================
# Protected /dev console and demo monitoring
# ===========================================
# Set this in the deployment secret manager. Never commit the real password.
DEV_CONSOLE_PASSWORD=replace_with_a_strong_password
DEV_CONSOLE_SESSION_SECRET=replace_with_an_independent_random_secret

# Public URL of the same deployed application being monitored.
DEV_MONITOR_BASE_URL=https://app.example.com
# Set false to disable automatic monitoring while retaining manual runs.
DEV_MONITOR_SCHEDULER_ENABLED=true
# JSON map keyed by: coopadmin, member, member_zero, member_kyc, org_admin, auditer, aud_E.
DEV_MONITOR_ACCOUNTS_JSON={}
# Dedicated Stripe test-mode key used only by demo monitoring; never use a live key here.
DEV_MONITOR_STRIPE_SECRET_KEY=sk_test_replace_me
# At least 32 random characters. It signs a 60-second, demo-account-only CAPTCHA
# bypass for the server-side monitor; normal users can never use the bypass.
DEV_MONITOR_INTERNAL_SECRET=replace_with_a_long_independent_random_secret

# Fixed demo tenant allowlist. Reset refuses any other tenant IDs.
DEV_DEMO_COOP_ID=demo_cooperative_document_id
DEV_DEMO_AUDIT_ORG_ID=demo_audit_org_document_id
# JSON array containing only collections owned by the demo baseline.
DEV_DEMO_RESET_COLLECTIONS_JSON=[]
# Versioned baseline manifest: accounts, cleanup queries and documents.
DEV_DEMO_BASELINE_JSON={"version":"1","coopId":"demo_cooperative_document_id","auditOrgId":"demo_audit_org_document_id","accounts":[],"cleanup":[],"documents":[]}
