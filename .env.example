# ===========================================
# Server-Side Only Variables (NOT exposed to browser)
# ===========================================
# These are used by API routes and server components only
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=your_database_id

# Google reCAPTCHA Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Active Captcha Provider Config ('google' | 'trustcaptcha' | 'disabled')
CAPTCHA_PROVIDER=google

# TrustCaptcha Secret Key (Preserved for fallback)
TRUST_CAPTCHA_API_KEY=your_trust_captcha_secret_key_here

# ===========================================
# Client-Side Variables (exposed to browser)
# ===========================================
# Only include these if you still need client-side Appwrite operations
# Consider removing these if all operations go through API routes
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id

# Active Captcha Provider Config (Exposed to client)
NEXT_PUBLIC_CAPTCHA_PROVIDER=google

# Google reCAPTCHA Site Key (Exposed to client)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# TrustCaptcha Site Key (Exposed to client)
NEXT_PUBLIC_TRUST_CAPTCHA_SITE_KEY=your_trust_captcha_site_key_here
